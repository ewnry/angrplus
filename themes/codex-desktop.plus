body.agy-codex-plus [role="menu"]:has([data-testid="add-context-menu"]) {border-radius:18px!important;box-shadow:none!important;background:var(--popover,var(--card))!important}

/* The attachment menu keeps Antigravity actions, with Codex-sized rows. */
body.agy-codex-plus:has(button[aria-label="Add context"][data-state="open"]) [role="menu"] {width:min(720px,calc(100vw - 80px))!important;max-width:calc(100vw - 80px)!important;padding:10px!important;border-radius:18px!important;background:var(--popover,var(--card))!important;border:1px solid var(--border)!important;box-shadow:none!important}
body.agy-codex-plus:has(button[aria-label="Add context"][data-state="open"]) [role="menuitem"] {min-height:32px!important;padding:6px 10px!important;border-radius:8px!important;font-size:13px!important}
