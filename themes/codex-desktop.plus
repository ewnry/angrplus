body.agy-codex-plus .codex-picker-trigger::before,body.agy-codex-plus .codex-picker-trigger::after,body.agy-codex-plus .codex-mode-trigger::before,body.agy-codex-plus .codex-mode-trigger::after {content:none!important;display:none!important}
