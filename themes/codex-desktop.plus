@plus 1
@layout native
@script
const body = document.body;
body.classList.add('agy-codex-plus');
const rail = document.createElement('aside');
rail.className = 'codex-nav-rail';
rail.setAttribute('aria-label', 'Codex navigation');
// Lucide SVGs: same icon library bundled by Codex Desktop.
const icon = {
  "home": "<!-- @license lucide-static v1.72.0 - ISC --><svg  class=\"lucide lucide-house\"  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"2\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\">  <path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\" />  <path d=\"M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\" /></svg>",
  "search": "<!-- @license lucide-static v1.72.0 - ISC --><svg  class=\"lucide lucide-search\"  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"2\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\">  <path d=\"m21 21-4.34-4.34\" />  <circle cx=\"11\" cy=\"11\" r=\"8\" /></svg>",
  "automation": "<!-- @license lucide-static v1.72.0 - ISC --><svg  class=\"lucide lucide-clock\"  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"2\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\">  <circle cx=\"12\" cy=\"12\" r=\"10\" />  <path d=\"M12 6v6l4 2\" /></svg>",
  "custom": "<!-- @license lucide-static v1.72.0 - ISC --><svg  class=\"lucide lucide-layout-grid\"  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"2\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\">  <rect width=\"7\" height=\"7\" x=\"3\" y=\"3\" rx=\"1\" />  <rect width=\"7\" height=\"7\" x=\"14\" y=\"3\" rx=\"1\" />  <rect width=\"7\" height=\"7\" x=\"14\" y=\"14\" rx=\"1\" />  <rect width=\"7\" height=\"7\" x=\"3\" y=\"14\" rx=\"1\" /></svg>",
  "account": "<!-- @license lucide-static v1.72.0 - ISC --><svg  class=\"lucide lucide-circle-user-round\"  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"2\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\">  <path d=\"M17.925 20.056a6 6 0 0 0-11.851.001\" />  <circle cx=\"12\" cy=\"11\" r=\"4\" />  <circle cx=\"12\" cy=\"12\" r=\"10\" /></svg>",
  "edit": "<!-- @license lucide-static v1.72.0 - ISC --><svg  class=\"lucide lucide-square-pen\"  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"2\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\">  <path d=\"M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7\" />  <path d=\"M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z\" /></svg>",
  "terminal": "<!-- @license lucide-static v1.72.0 - ISC --><svg  class=\"lucide lucide-terminal\"  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"2\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\">  <path d=\"M12 19h8\" />  <path d=\"m4 17 6-6-6-6\" /></svg>",
  "chevron": "<!-- @license lucide-static v1.72.0 - ISC --><svg  class=\"lucide lucide-chevron-down\"  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"2\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\">  <path d=\"m6 9 6 6 6-6\" /></svg>",
  "right": "<!-- @license lucide-static v1.72.0 - ISC --><svg  class=\"lucide lucide-chevron-right\"  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"2\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\">  <path d=\"m9 18 6-6-6-6\" /></svg>",
  "check": "<!-- @license lucide-static v1.72.0 - ISC --><svg  class=\"lucide lucide-check\"  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"2\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\">  <path d=\"M20 6 9 17l-5-5\" /></svg>",
  "usage": "<!-- @license lucide-static v1.72.0 - ISC --><svg  class=\"lucide lucide-gauge\"  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"2\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\">  <path d=\"m12 14 4-4\" />  <path d=\"M3.34 19a10 10 0 1 1 17.32 0\" /></svg>",
  "settings": "<!-- @license lucide-static v1.72.0 - ISC --><svg  class=\"lucide lucide-settings\"  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"2\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\">  <path d=\"M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915\" />  <circle cx=\"12\" cy=\"12\" r=\"3\" /></svg>",
  "users": "<!-- @license lucide-static v1.72.0 - ISC --><svg  class=\"lucide lucide-users-round\"  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"2\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\">  <path d=\"M18 21a8 8 0 0 0-16 0\" />  <circle cx=\"10\" cy=\"8\" r=\"5\" />  <path d=\"M22 20c0-3.37-2-6.5-4-8a5 5 0 0 0-.45-8.3\" /></svg>",
  "zap": "<!-- @license lucide-static v1.72.0 - ISC --><svg  class=\"lucide lucide-zap\"  xmlns=\"http://www.w3.org/2000/svg\"  width=\"24\"  height=\"24\"  viewBox=\"0 0 24 24\"  fill=\"none\"  stroke=\"currentColor\"  stroke-width=\"2\"  stroke-linecap=\"round\"  stroke-linejoin=\"round\">  <path d=\"M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z\" /></svg>"
};
function navButton(name,label,action) {
  const el=document.createElement('button');el.type='button';el.title=label;el.setAttribute('aria-label',label);
  el.innerHTML=icon[name];
  el.addEventListener('click',action);rail.append(el);return el;
}
const homeNav=navButton('home','Новый чат',()=>api.ui.click('[data-testid="new-conversation-button"]'));
const automationNav=navButton('automation','Автоматизации',()=>api.ui.click('[data-testid="automations-button"]'));
const customNav=navButton('custom','Настройки агента',()=>api.ui.click('a[href="/customizations"]'));
function syncNav(){const route=window.location.pathname+' '+window.location.hash;const active=/automations|sidecars/.test(route)?automationNav:/customizations/.test(route)?customNav:homeNav;for(const b of [homeNav,automationNav,customNav]){b.classList.toggle('is-current',b===active);if(b===active)b.setAttribute('aria-current','page');else b.removeAttribute('aria-current')}}
const spacer=document.createElement('div');spacer.className='codex-nav-spacer';rail.append(spacer);
const usage=navButton('usage','Лимиты моделей',()=>api.ui.click('#agy-native-quotas'));usage.classList.add('codex-usage-button');
const profile=navButton('account','Профиль',()=>toggleProfile());let identity={name:'',email:''};
if(api.layout?.identity)api.layout.identity().then(data=>{identity=data||identity;if(identity.name){profile.textContent=identity.name.slice(0,2).toUpperCase();profile.classList.add('codex-profile-avatar')}}).catch(()=>{});
body.append(rail);
const brand=document.createElement('div');brand.className='codex-sidebar-brand';
const modeButton=document.createElement('button');modeButton.className='codex-mode-trigger';modeButton.type='button';modeButton.setAttribute('aria-label','Переключить режим');
const searchButton=document.createElement('button');searchButton.className='codex-sidebar-search';searchButton.type='button';searchButton.setAttribute('aria-label','Поиск чатов');searchButton.innerHTML=icon.search;searchButton.onclick=()=>api.ui.click('[data-testid="sidebar-search-button"]');
brand.append(modeButton,searchButton);
let modeMenu=null,profileMenu=null;
function closePopovers(){modeMenu?.remove();modeMenu=null;profileMenu?.remove();profileMenu=null;modeButton.setAttribute('aria-expanded','false');profile.setAttribute('aria-expanded','false')}
function modeName(){return api.layout?.get()==='cowork'?'Gemini Web':'Codex'}
function refreshMode(){modeButton.replaceChildren(document.createTextNode(modeName()+' '));modeButton.insertAdjacentHTML('beforeend',icon.chevron)}
function modeChoice(name,description,value){const b=document.createElement('button');b.type='button';b.className='codex-menu-row';const label=document.createElement('strong');label.textContent=name;const detail=document.createElement('small');detail.textContent=description;b.append(label,detail);if(api.layout?.get()===value)b.insertAdjacentHTML('beforeend',icon.check);b.onclick=()=>{if(api.layout?.set(value)){refreshMode();closePopovers()}};return b}
modeButton.onclick=()=>{if(modeMenu){closePopovers();return}closePopovers();modeMenu=document.createElement('div');modeMenu.className='codex-mode-menu';modeMenu.setAttribute('role','menu');modeMenu.append(modeChoice('Gemini Web','Чаты и модели Gemini','cowork'),modeChoice('Codex','Задачи и работа с кодом','code'));brand.append(modeMenu);modeButton.setAttribute('aria-expanded','true')};
function profileAction(label,action,iconName){const b=document.createElement('button');b.type='button';b.className='codex-profile-action';b.innerHTML=icon[iconName];const text=document.createElement('span');text.textContent=label;b.append(text);b.onclick=()=>{closePopovers();action()};return b}
function toggleProfile(){if(profileMenu){closePopovers();return}closePopovers();profileMenu=document.createElement('div');profileMenu.className='codex-profile-menu';profileMenu.setAttribute('role','menu');if(identity.name||identity.email){const head=document.createElement('div');head.className='codex-profile-heading';const name=document.createElement('strong');name.textContent=identity.name;const email=document.createElement('small');email.textContent=identity.email;head.append(name,email);profileMenu.append(head)}profileMenu.append(profileAction('Аккаунты и лимиты',()=>api.layout?.openAccounts(),'users'),profileAction('Настройки',()=>api.layout?.openSettings(),'settings'));rail.append(profileMenu);profile.setAttribute('aria-expanded','true')}
refreshMode();if(api.layout)api.layout.set(api.layout.get());
const projectLabels=new Map();
function attachBrand() { syncNav(); const nav=document.querySelector('[role="navigation"][aria-label="Sidebar"]');if(nav&&!nav.contains(brand))nav.prepend(brand);for(const header of nav?.querySelectorAll('[data-testid="project-header"]')||[]){const path=header.getAttribute('data-project-label')||'';const label=header.querySelector('span.truncate');if(path&&label){const name=path.replace(/[\\/]+$/,'').split(/[\\/]/).pop()||path;if(label.dataset.codexProjectName!==name)label.dataset.codexProjectName=name;const button=header.matches('button')?header:label.closest('button');if(button){if(!projectLabels.has(button))projectLabels.set(button,button.getAttribute('aria-label'));if(button.getAttribute('aria-label')!==name)button.setAttribute('aria-label',name)}if(header.title!==path)header.title=path}}usage.hidden=!document.querySelector('#agy-native-quotas'); }
function syncSettings() {
  const dialog=document.querySelector('[role="dialog"][aria-label="Settings"]');
  const general=dialog?.querySelector('[data-testid="settings-nav-item-General"]');if(!general)return;
  let row=general.parentElement;while(row&&row!==dialog){const style=window.getComputedStyle(row);if(style.display.includes('flex')&&style.flexDirection==='row'&&row.children.length>=2)break;row=row.parentElement}
  if(!row||row===dialog)return;const sidebar=Array.from(row.children).find(node=>node.contains(general));if(!sidebar)return;
  if(!sidebar.hasAttribute('data-codex-settings-sidebar'))sidebar.setAttribute('data-codex-settings-sidebar','');
  for(const child of row.children)if(child!==sidebar&&!child.hasAttribute('data-codex-settings-content'))child.setAttribute('data-codex-settings-content','');
  let search=sidebar.querySelector('.codex-settings-search');if(!search){const wrap=document.createElement('label');wrap.className='codex-settings-search';wrap.innerHTML=icon.search;const input=document.createElement('input');input.type='search';input.placeholder='Поиск';input.setAttribute('aria-label','Поиск настроек');wrap.append(input);(general.parentElement||sidebar).insertBefore(wrap,general);input.addEventListener('input',filterSettings);search=wrap}
}
function filterSettings(){const sidebar=document.querySelector('[data-codex-settings-sidebar]');const query=sidebar?.querySelector('input')?.value.trim().toLocaleLowerCase()||'';sidebar?.querySelectorAll('[data-testid^="settings-nav-item-"],#agy-tab-general-plus').forEach(item=>{item.hidden=!!query&&!item.textContent.toLocaleLowerCase().includes(query)})}
attachBrand();syncSettings();const navObserver=new MutationObserver(()=>{attachBrand();syncSettings()});navObserver.observe(document.body,{childList:true,subtree:true});
api.ui.replace('[data-testid="home-greeting"]',()=>{
  const hero=document.createElement('div');hero.className='codex-home-greeting';
  hero.innerHTML=icon.terminal+'<span>Что будем создавать?</span>';
  return hero;
});
let picker=null,menu=null;let modelState=api.models.get();
function family(label){return String(label||'').replace(/\s*\((?:Low|Medium|High)\)\s*$/i,'').trim()}
function currentEffort(){return api.models.effort()}
function closeMenu(){menu?.remove();menu=null;picker?.querySelector('button')?.setAttribute('aria-expanded','false')}
function addText(tag,cls,text){const e=document.createElement(tag);e.className=cls;e.textContent=text;return e}
function modelTitle(){const state=api.models.get();const effort=currentEffort().selected;return (family(state.selected?.label)||'Select model')+(effort?' · '+effort:'')}
function updatePicker(){if(!picker)return;const b=picker.querySelector('.codex-picker-trigger');if(!b)return;const text=modelTitle();if(b.dataset.modelTitle!==text){b.dataset.modelTitle=text;b.replaceChildren(document.createTextNode(text+' '));b.insertAdjacentHTML('beforeend',icon.chevron)}}
function openMenu(kind){
  closeMenu();if(!picker)return;const state=api.models.get();
  menu=document.createElement('div');menu.className='codex-picker-menu '+(kind==='models'?'codex-models-menu':'codex-effort-menu');menu.setAttribute('role','dialog');
  if(kind==='models'){
    menu.append(addText('div','codex-menu-caption','Choose model'));
    const groups=new Map();for(const item of state.options){const name=family(item.label);if(!name)continue;const prior=groups.get(name);if(!prior||prior.disabled&&!item.disabled)groups.set(name,item)}
    for(const [name,item] of groups){const b=addText('button','codex-model-option',name);b.type='button';b.disabled=!!item.disabled;b.setAttribute('role','menuitemradio');b.setAttribute('aria-checked',String(name===family(state.selected?.label)));if(name===family(state.selected?.label))b.insertAdjacentHTML('beforeend',icon.check);b.onclick=async()=>{if(await api.models.select(item.value))openMenu('effort')};menu.append(b)}
    if(!groups.size)menu.append(addText('div','codex-menu-caption','Models are loading…'));
  }else{
    const data=currentEffort(),top=document.createElement('div');top.className='codex-effort-top';
    const mark=addText('span','codex-effort-mark','');mark.innerHTML=icon.zap;const center=document.createElement('div');center.append(addText('div','codex-effort-value',data.selected||'Default'));
    const models=addText('button','codex-effort-model',family(state.selected?.label)||'Choose model');models.insertAdjacentHTML('beforeend',icon.right);models.type='button';models.onclick=()=>openMenu('models');center.append(models);
    const reset=addText('span','codex-effort-reset','');top.append(mark,center,reset);menu.append(top);
    if(data.options.length>1){const range=document.createElement('input');range.type='range';range.className='codex-effort-range';range.min='0';range.max=String(data.options.length-1);range.step='1';range.value=String(Math.max(0,data.options.indexOf(data.selected)));range.setAttribute('aria-label','Reasoning effort');const paint=()=>{const progress=(Number(range.value)/Number(range.max)*100)+'%';range.style.setProperty('--progress',progress);range.parentElement?.style.setProperty('--progress',progress);range.parentElement?.style.setProperty('--progress-ratio',String(Number(range.value)/Number(range.max)));center.querySelector('.codex-effort-value').textContent=data.options[Number(range.value)]};paint();range.addEventListener('input',paint);range.addEventListener('change',async()=>{range.disabled=true;const ok=await api.models.setEffort(data.options[Number(range.value)]);range.disabled=false;if(!ok)center.querySelector('.codex-effort-value').textContent='Unavailable';updatePicker()});const track=document.createElement('div');track.className='codex-effort-track';const dots=document.createElement('div');dots.className='codex-effort-dots';for(let i=0;i<data.options.length;i++)dots.append(document.createElement('i'));const thumb=document.createElement('span');thumb.className='codex-effort-thumb';track.append(dots,range,thumb);menu.append(track);paint()}
    else menu.append(addText('div','codex-menu-caption','No adjustable effort for this model'));
  }
  picker.append(menu);picker.querySelector('.codex-picker-trigger')?.setAttribute('aria-expanded','true');
}
api.ui.replace('[data-testid="model-selector-trigger"]',()=>{
  const root=document.createElement('div');root.className='codex-model-picker';picker=root;
  const trigger=addText('button','codex-picker-trigger','Select model');trigger.type='button';trigger.setAttribute('aria-label','Model and reasoning effort');trigger.setAttribute('aria-haspopup','dialog');trigger.setAttribute('aria-expanded','false');trigger.onclick=()=>menu?closeMenu():openMenu('effort');root.append(trigger);updatePicker();return root;
});
const unsub=api.models.subscribe(state=>{modelState=state;updatePicker()});
function outside(event){if(menu&&picker&&!picker.contains(event.target))closeMenu();if((modeMenu&&!brand.contains(event.target))||(profileMenu&&!rail.contains(event.target)))closePopovers()}
function keys(event){if(event.key==='Escape'&&(menu||modeMenu||profileMenu)){event.stopPropagation();closeMenu();closePopovers()}}
window.addEventListener('popstate',syncNav);window.addEventListener('hashchange',syncNav);document.addEventListener('pointerdown',outside,true);document.addEventListener('keydown',keys,true);
return ()=>{unsub();navObserver.disconnect();window.removeEventListener('popstate',syncNav);window.removeEventListener('hashchange',syncNav);document.removeEventListener('pointerdown',outside,true);document.removeEventListener('keydown',keys,true);closeMenu();closePopovers();for(const [button,oldLabel] of projectLabels){if(oldLabel===null)button.removeAttribute('aria-label');else button.setAttribute('aria-label',oldLabel)}projectLabels.clear();document.querySelectorAll('.codex-settings-search').forEach(n=>n.remove());document.querySelectorAll('[data-codex-settings-sidebar],[data-codex-settings-content]').forEach(n=>{n.removeAttribute('data-codex-settings-sidebar');n.removeAttribute('data-codex-settings-content');n.querySelectorAll('[data-testid^=settings-nav-item-],#agy-tab-general-plus').forEach(item=>item.hidden=false)});if(api.layout){api.layout.set('code');body.classList.remove('agy-custom-cowork-enabled')}brand.remove();rail.remove();body.classList.remove('agy-codex-plus')};
@end
@css
/* Codex Desktop dark. Existing Antigravity controls and conversation remain mounted. */
body.agy-codex-plus { font-family:system-ui,-apple-system,'Segoe UI',sans-serif!important }
body.agy-codex-plus .agy-shell,body.agy-codex-plus .agy-inset-shell {background:var(--background)!important;color:var(--foreground)!important}
body.agy-codex-plus [data-testid="title-menu-bar"] {background:var(--sidebar,var(--background))!important;color:var(--muted-foreground)!important}
body.agy-codex-plus .codex-nav-rail {position:fixed;left:0;top:40px;bottom:0;width:52px;z-index:100;display:flex;flex-direction:column;align-items:center;gap:7px;padding:8px 0;background:var(--sidebar,var(--background));border-right:1px solid var(--border)}
body.agy-codex-plus .codex-nav-rail button {width:36px;height:36px;display:grid;place-items:center;border:0;border-radius:9px;background:transparent;color:var(--muted-foreground);cursor:pointer}
body.agy-codex-plus .codex-nav-rail button:hover,body.agy-codex-plus .codex-nav-rail button.is-current {background:var(--accent);color:var(--foreground)}
body.agy-codex-plus .codex-nav-spacer {flex:1}
body.agy-codex-plus [role="navigation"][aria-label="Sidebar"] {padding-left:52px!important;background:var(--sidebar,var(--background))!important;border-right:1px solid var(--sidebar-accent,var(--accent))!important;box-sizing:border-box!important}
body.agy-codex-plus .relative.flex.w-full.h-full.outline-none > .flex[style*="width: min("]:has([role="navigation"][aria-label="Sidebar"]) {width:min(315px,calc(100% - 309px))!important}
body.agy-codex-plus .relative.flex.w-full.h-full.outline-none > .flex[style*="width: min("]:has([role="navigation"][aria-label="Sidebar"]) > .h-full.w-full {width:100%!important}
body.agy-codex-plus .codex-sidebar-brand {display:flex;align-items:center;flex:none;height:50px;padding:0 16px;color:var(--foreground);font-size:16px;font-weight:600}
body.agy-codex-plus [role="navigation"][aria-label="Sidebar"] > .codex-sidebar-brand + .shrink-0 {display:none!important}
body.agy-codex-plus [data-testid="sidebar-navigation-items"] > :not([data-testid="new-conversation-button"]) {display:none!important}
body.agy-codex-plus [data-testid="new-conversation-button"] {background:transparent!important;border:0!important;color:var(--foreground)!important;font-weight:400!important}
body.agy-codex-plus [data-testid="conversation-row-sidebar"] {border-radius:8px!important;min-height:30px!important;color:var(--foreground)!important}
body.agy-codex-plus [data-testid="conversation-row-sidebar"]:hover,body.agy-codex-plus [data-testid="conversation-row-sidebar"][data-selected="true"] {background:var(--sidebar-accent,var(--accent))!important}
body.agy-codex-plus [data-testid="home-greeting"] + .codex-home-greeting,.codex-home-greeting {display:flex;flex-direction:column;align-items:center;gap:22px;color:var(--foreground);font-size:28px;font-weight:400;line-height:1.2}
body.agy-codex-plus .codex-home-greeting svg {color:var(--muted-foreground)}
body.agy-codex-plus #agy-native-history-host {display:none!important}
body.agy-codex-plus [data-testid="agent-input-box"] {max-width:800px!important;margin-left:auto!important;margin-right:auto!important}
body.agy-codex-plus [id="antigravity.agentSidePanelInputBox"] {background:var(--card,var(--background))!important;border:1px solid var(--border)!important;border-radius:20px!important;box-shadow:none!important}
body.agy-codex-plus [id="antigravity.agentSidePanelInputBox"] [contenteditable="true"] {font-size:14px!important;line-height:1.5!important;min-height:54px}
