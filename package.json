{
  "name": "angrplus",
  "productName": "Antigravity+",
  "version": "2.1.17",
  "description": "Antigravity+ — Multi-account quota pool, seamless hot-swap & custom UI.",
  "license": "Apache-2.0",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "tsc --build --clean",
    "patch": "node scripts/deploy.mjs",
    "patch:check": "node scripts/deploy.mjs --check",
    "patch:restore": "node scripts/deploy.mjs --restore",
    "build:installer": "node scripts/build-installer.mjs",
    "build:powershell": "node scripts/build-powershell-installer.mjs",
    "build:unix": "node scripts/build-unix-installer.mjs"
  },
  "dependencies": {
    "chrome-devtools-mcp": "^0.23.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "shell-env": "^4.0.3"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
